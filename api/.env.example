# Copy to .env for local development. All settings can also be real
# environment variables (they win over the file).

# SQLAlchemy URL of the PostgreSQL database
DATABASE_URL=postgresql+psycopg://timesheets:timesheets@localhost:5432/timesheets

# Signs the access tokens. Use a long random value outside development.
SECRET_KEY=change-me-in-production-0123456789abcdef

# Lifetime of an access token in minutes (default one week)
TOKEN_TTL_MINUTES=10080

# Comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
